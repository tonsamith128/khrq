{
  "name": "tonsamith/khqr-workspace",
  "description": "Development workspace for KHQR framework-independent PHP SDK and adapters.",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Ton Samith",
      "homepage": "https://tonsamith.com"
    }
  ],
  "homepage": "https://khqr.tonsamith.com",
  "require": {
    "php": "^8.2"
  },
  "autoload": {
    "psr-4": {
      "TonSamith\\Khqr\\Core\\": "packages/core/src/",
      "TonSamith\\Khqr\\Php\\": "packages/php/src/",
      "TonSamith\\Khqr\\Bakong\\": "packages/bakong/src/"
    }
  },
  "scripts": {
    "test": [
      "@php tests/run.php",
      "@php tests/bakong-http.php"
    ],
    "lint": "php tests/lint.php"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
